# AWS deployment settings. Any value can be overridden with an environment variable.

# AWS CLI profile for this project (IAM user beverage-alcohol-distributor). The scripts never use any other profile.
AWS_PROFILE=${AWS_PROFILE_OVERRIDE:-beverage-alcohol-distributor}
# Fill in once you know the new account's ID; the scripts then refuse to run against any other account.
EXPECTED_ACCOUNT_ID=${EXPECTED_ACCOUNT_ID:-677476680276}
AWS_REGION=${AWS_REGION:-us-east-1}
# Accounts these scripts must never deploy to (space-separated account IDs).
FORBIDDEN_ACCOUNT_IDS=""

PROJECT=${PROJECT:-bevdist}
INFRA_STACK=${INFRA_STACK:-bevdist-infra}
SERVICES_STACK=${SERVICES_STACK:-bevdist-services}
SERVICES="order-api compliance-service inventory-allocator web"

# Demo data (fictional accounts, licenses, products, stock) is loaded on first start when true.
SEED_DEMO_DATA=${SEED_DEMO_DATA:-true}
